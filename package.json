{
  "name": "duo-personal-pwa",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:pages": "node scripts/check-pages.mjs",
    "cloudflare:check": "wrangler deploy --dry-run --outdir /tmp/duo-worker-build",
    "test:private": "node scripts/check-private.mjs",
    "test:oauth-runtime": "node scripts/check-oauth-runtime.mjs",
    "deploy:private": "node scripts/deploy-private.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.9",
    "vite": "^7.1.0",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
