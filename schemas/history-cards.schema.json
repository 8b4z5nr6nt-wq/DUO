{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "歴史総合のカード教材",
  "type": "object",
  "required": ["format", "version", "subject", "cards"],
  "properties": {
    "format": { "const": "subject-cards" },
    "version": { "const": 1 },
    "subject": { "const": "history" },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "description": "同じファイル内でカード番号を重複させないでください。",
      "items": {
        "type": "object",
        "required": ["number", "question", "answer"],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "deck": { "const": "general" },
          "question": { "type": "string", "pattern": "\\S" },
          "answer": { "type": "string", "pattern": "\\S" },
          "category": {
            "description": "era（年代）、person（人物）、event（出来事）、term（用語）、other（その他）、uncategorized（未分類）。省略した新規カードは未分類になり、既存カードの更新では元の分類を引き継ぎます。",
            "enum": ["era", "person", "event", "term", "other", "uncategorized"]
          }
        }
      }
    }
  }
}
