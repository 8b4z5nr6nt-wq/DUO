{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "duo-materials"
    },
    "version": {
      "const": 1
    },
    "sections": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sentences": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "ja": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "words": {
                  "type": "array",
                  "maxItems": 10000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "number": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "ja": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "related": {
                        "type": "array",
                        "maxItems": 10000,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "en": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "\\S"
                            },
                            "ja": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "\\S"
                            }
                          },
                          "required": ["en", "ja"]
                        }
                      }
                    },
                    "required": ["number", "en", "ja"]
                  }
                }
              },
              "required": ["number", "en", "ja"]
            }
          }
        },
        "required": ["number", "sentences"]
      }
    }
  },
  "required": ["format", "version", "sections"],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
